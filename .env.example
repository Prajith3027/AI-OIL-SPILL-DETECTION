# ─────────────────────────────────────────────
# AI Oil Spill Intelligence — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.
# ─────────────────────────────────────────────

# ── Database ──────────────────────────────────
# PostgreSQL + PostGIS connection string
DATABASE_URL=postgresql://oilspill_user:your_password_here@localhost:5432/oilspill_db

# ── Security ──────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ae5a51749de9a652a151a78ea1a22297

# ── CORS ──────────────────────────────────────
# Frontend origin for CORS whitelisting
FRONTEND_URL=http://localhost:5173

# ── Database credentials (used by docker-compose) ──
POSTGRES_USER=oilspill_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=oilspill_db
POSTGRES_PORT=5432

# ── Application ───────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
